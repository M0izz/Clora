# INDUSAI-X: Sovereign On-Premise Industrial Agentic AI Workbench (SIH26117 / MRPL)
# Configuration Template

DEBUG=True
APP_NAME=INDUSAI-X
ENVIRONMENT=local-airgap

STORAGE_DIR=./storage
DATABASE_URL=sqlite:///./storage/indusai.db
VECTOR_STORE_DIR=./data/chroma
VECTOR_COLLECTION_NAME=mrpl_evidence_store

OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_LLM_MODEL=llama3.2:3b
VLM_MODEL=moondream:latest
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

INTERNAL_SERVICE_KEY=indusai-internal-worker-key-dev
ENFORCE_AIRGAP_SENTINEL=True
AUDIT_LOG_PATH=./audit_trail.jsonl
AIRGAP_PROOF_PATH=./airgap_proof_log.jsonl

MAX_FILE_SIZE_MB=50
SYNC_QUERY_TIMEOUT_SEC=30
